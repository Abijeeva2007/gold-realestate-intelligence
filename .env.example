# Pipeline Configuration
LOG_LEVEL=INFO
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=data/reports

# Data Source Access (Optional API keys where applicable)
# St. Louis Fed FRED API Key (free registration at https://fred.stlouisfed.org)
FRED_API_KEY=

# Nasdaq Data Link API Key (for LBMA bulk feeds if license acquired)
NASDAQ_API_KEY=

# Database Integration (SQLAlchemy connection string)
DATABASE_URL=sqlite:///data/gold_intelligence.db
# For PostgreSQL: postgresql://username:password@localhost:5432/gold_db
